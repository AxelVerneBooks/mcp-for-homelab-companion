# Recipe 01 — Read-Only Media Librarian
# Copy to .env and set MEDIA_DIR to a real directory on the Docker host.
# Leave unset to keep the baked-in demo tree.
MEDIA_DIR=/tank/media

# The server runs as nobody (65534) by default. If your media isn't
# world-readable, set these to a read-only media user's UID/GID instead —
# never 0 (see SECURITY.md).
# PUID=1000
# PGID=1000
