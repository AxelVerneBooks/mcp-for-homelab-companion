# Recipe 14 — Gitea Scribe
# Copy to .env. Token for a DEDICATED bot user, scopes: read:repository,
# read:issue, read:user (Settings → Applications). Never your own token.
GITEA_HOST=https://gitea.local
GITEA_ACCESS_TOKEN=change-me-read-only-bot-token
# Self-signed cert? Install your CA instead of setting this to true.
GITEA_INSECURE=false
