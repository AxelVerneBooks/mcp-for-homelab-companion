# Recipe 07 — Pi-hole Query Detective
# Copy to .env. Token should be read-only scoped; disabling blocking
# stays behind the approval click forever (book, Chapter 5).
PIHOLE_URL=http://pihole.local
PIHOLE_TOKEN=change-me-read-only-token

# Published port binds to loopback by default. Set to this host's LAN IP
# if your MCP client runs on another machine (see SECURITY.md).
# MCP_BIND_ADDR=192.168.1.10
