# Recipe 07 — Pi-hole Query Detective
# Copy to .env.
PIHOLE_URL=http://pihole.local
# An APP PASSWORD, not your login password:
# Settings → Web interface / API → Advanced → "Configure app password".
PIHOLE_PASSWORD=change-me-app-password

# Bearer token your MCP client must send (16+ chars):  openssl rand -hex 32
PIHOLE_MCP_TOKEN=change-me-to-a-random-hex-string

# The host name or IP your client uses in the stanza URL (http://<this>:9107/mcp).
MCP_HOSTNAME=docker-host.local
