# Recipe 03 — Home Assistant Concierge
# Copy to .env. Token must belong to a DEDICATED, non-admin user created
# for the assistant. Never your personal HA token.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=eyJ...long-lived-access-token...

# The MCP endpoint lives at http://<docker-host>:9103/<MCP_SECRET_PATH>.
# Anyone who knows the path can use the server: generate it, don't invent it.
#   openssl rand -hex 24
MCP_SECRET_PATH=change-me-to-a-random-hex-string

# Week one: reads only. Set to false only after the Chapter 5 ceremony.
READ_ONLY_MODE=true
