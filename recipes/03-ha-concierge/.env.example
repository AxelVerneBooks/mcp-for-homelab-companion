# Recipe 03 — Home Assistant Concierge
# Copy to .env. Token must belong to a DEDICATED user with houseguest
# permissions (no locks/alarms/garage). Never your personal HA token.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=eyJ...long-lived-access-token...

# Published port binds to loopback by default. Set to this host's LAN IP
# if your MCP client runs on another machine (see SECURITY.md).
# MCP_BIND_ADDR=192.168.1.10
