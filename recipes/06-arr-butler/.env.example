# Recipe 06 — Radarr Butler
# Copy to .env. API key: Radarr → Settings → General → Security.
# ARR_URL is as seen from the container (container name, or host IP).
ARR_URL=http://radarr:7878
ARR_KEY=00000000000000000000000000000000

# Interface the MCP port listens on. 127.0.0.1 = this host only (default).
# The server has no auth: use your LAN IP only on a network you trust.
MCP_BIND=127.0.0.1
