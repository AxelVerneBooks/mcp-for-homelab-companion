# Recipe 08 — NAS Health Warden
# Copy to .env. READ-ONLY API key for a dedicated user
# (TrueNAS: Credentials → Users → API Keys).
TN_URL=wss://truenas.local/websocket
TN_KEY=change-me-read-only-api-key

# Published port binds to loopback by default. Set to this host's LAN IP
# if your MCP client runs on another machine (see SECURITY.md).
# MCP_BIND_ADDR=192.168.1.10
