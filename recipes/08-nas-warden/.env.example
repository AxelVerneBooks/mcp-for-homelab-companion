# Recipe 08 — NAS Health Warden
# Copy to .env.
# TrueNAS host, optionally host:port. No scheme, no /websocket path.
TN_HOST=truenas.local
# true while TrueNAS uses its self-signed certificate.
TN_INSECURE=true
#
# The READ-ONLY API key does NOT go here: your MCP client sends it as a
# bearer token (see README stanza). Create it for a dedicated user under
# Credentials → Users → (user) → API Keys.
