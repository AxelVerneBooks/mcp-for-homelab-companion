# Recipe 02 — Docker Forensics
# Copy to .env (optional). Every value below is a READ permission on one
# section of the Docker API, enforced by the socket proxy. 1 = readable,
# 0 = 403. Writes (start/stop/rm/pull) are always refused (POST=0 is fixed
# in the compose file on purpose).
PROXY_CONTAINERS=1
PROXY_IMAGES=1
PROXY_NETWORKS=1
PROXY_VOLUMES=1
PROXY_INFO=1
