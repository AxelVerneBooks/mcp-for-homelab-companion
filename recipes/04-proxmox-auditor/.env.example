# Recipe 04 — Proxmox Auditor
# Copy to .env. Token must have the PVEAuditor role for week one.
# Format: user@realm!tokenid=secret  (create under Datacenter → Permissions → API Tokens)
PVE_HOST=https://pve.local:8006
PVE_TOKEN=mcp-bot@pam!homelab=00000000-0000-0000-0000-000000000000
VERIFY_TLS=true

# Published port binds to loopback by default. Set to this host's LAN IP
# if your MCP client runs on another machine (see SECURITY.md).
# MCP_BIND_ADDR=192.168.1.10
