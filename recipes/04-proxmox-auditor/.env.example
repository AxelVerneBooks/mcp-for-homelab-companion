# Recipe 04 — Proxmox Auditor
# Copy to .env. Token must belong to a dedicated user with the PVEAuditor
# role for week one (Datacenter → Permissions → API Tokens).
# A token "mcp-bot@pve!homelab" splits into PVE_USER=mcp-bot@pve and
# PVE_TOKEN_NAME=homelab; PVE_TOKEN_VALUE is the UUID shown once at creation.
PVE_HOST=pve.local
PVE_PORT=8006
PVE_USER=mcp-bot@pve
PVE_TOKEN_NAME=homelab
PVE_TOKEN_VALUE=00000000-0000-0000-0000-000000000000
PVE_VERIFY_SSL=true

# Bearer token your MCP client must send. Generate it:  openssl rand -hex 32
MCP_API_KEY=change-me-to-a-random-hex-string
