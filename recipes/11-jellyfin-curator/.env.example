# Recipe 11 — Jellyfin Curator
# Copy to .env. Create a DEDICATED API key (Dashboard → API Keys) named
# "mcp" so you can revoke it without touching anything else.
JELLYFIN_URL=http://jellyfin.local:8096
JELLYFIN_API_KEY=change-me-dedicated-api-key
# Bearer token your MCP client must send. Generate: openssl rand -hex 32
MCP_HTTP_TOKEN=change-me-openssl-rand-hex-32
TZ=UTC
