# Recipe 05 — qBittorrent Night Manager
# Copy to .env.
# Host as seen from the qbit-mcp container: the qBit container's name on
# the shared network, with scheme. Port is the WebUI port.
QBIT_HOST=http://qbittorrent
QBIT_PORT=8080
# qBittorrent has ONE WebUI login; these are those credentials.
# Rotate the password after setup and keep it out of your notes app.
QBIT_USER=admin
QBIT_PASS=change-me-then-rotate-monthly

# Docker network your qBit container is on:  docker inspect qbittorrent -f '{{json .NetworkSettings.Networks}}'
QBIT_NETWORK=qbittorrent_default

# Bearer token your MCP client must send. Generate it:  openssl rand -hex 32
QBIT_MCP_TOKEN=change-me-to-a-random-hex-string
