# Recipe 05 — qBittorrent Night Manager
# Copy to .env. Credentials belong to a DEDICATED qBit account, not yours.
QBIT_URL=http://qbittorrent:8080
QBIT_USER=mcp-assistant
QBIT_PASS=change-me-then-rotate-monthly

# Published port binds to loopback by default. Set to this host's LAN IP
# if your MCP client runs on another machine (see SECURITY.md).
# MCP_BIND_ADDR=192.168.1.10
