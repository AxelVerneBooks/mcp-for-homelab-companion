# Recipe 09 — Grafana Question Answerer
# Copy to .env. Service-account token with the VIEWER role
# (Administration → Users and access → Service accounts).
GRAFANA_URL=http://grafana.local:3000
GRAFANA_TOKEN=glsa_change-me

# Bearer token your MCP client must send:  openssl rand -hex 32
GRAFANA_MCP_TOKEN=change-me-to-a-random-hex-string

# The host name your client uses in the stanza URL (http://<this>:9109/mcp).
MCP_HOSTNAME=docker-host.local
