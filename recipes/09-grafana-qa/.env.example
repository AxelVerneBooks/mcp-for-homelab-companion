# Recipe 09 — Grafana Question Answerer
# Copy to .env. Service-account token with the VIEWER role
# (Administration → Users → Service accounts).
GRAFANA_URL=http://grafana.local:3000
GRAFANA_TOKEN=lca...

# Published port binds to loopback by default. Set to this host's LAN IP
# if your MCP client runs on another machine (see SECURITY.md).
# MCP_BIND_ADDR=192.168.1.10
