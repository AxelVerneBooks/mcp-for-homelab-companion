# Recipe 09 — Grafana Question Answerer
# Copy to .env. Service-account token with the VIEWER role
# (Administration → Users → Service accounts).
GRAFANA_URL=http://grafana.local:3000
GRAFANA_TOKEN=glsa_...
# Host:port values your MCP client uses to reach this server (Host-header
# allowlist). Add your Docker host's name/IP, e.g. nas.lan:9109.
MCP_ALLOWED_HOSTS=localhost:9109,127.0.0.1:9109
